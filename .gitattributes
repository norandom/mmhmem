# Linux-consumed artifacts must keep LF endings in the working tree even on
# Windows checkouts (core.autocrlf=true rewrites text files to CRLF otherwise;
# systemd, logrotate, sh, and Docker all expect LF).
deploy/**        text eol=lf
.github/**       text eol=lf
Dockerfile       text eol=lf
docker-compose.yml text eol=lf
docker-compose.*.yml text eol=lf
.env.example     text eol=lf
*.sh             text eol=lf
.githooks/**     text eol=lf
*.service        text eol=lf
plugins/**       text eol=lf
.marketplace/**  text eol=lf
.agents/plugins/** text eol=lf
.claude-plugin/** text eol=lf
.gemini-plugin/** text eol=lf
/tests/fixtures/routing-instructions/*.bin -text
/tests/fixtures/store/*.db binary
