# mmhmem installer for Windows (Windows PowerShell 5.1 and PowerShell 7).
#
# Rendered for one release: the version and the SHA-256 of the download are
# written into this file when the release is published. It downloads that
# release's archive, checks it against the built-in SHA-256, unpacks it into a
# temporary folder and starts the mmhmem setup program, which does all the
# real work. It takes no options and does not change anything outside the
# temporary folder, which is always removed.
#
# Meant for:  irm <url>/install.ps1 | iex
# It does not call "exit" (that would close your terminal). When it finishes,
# $LASTEXITCODE holds the exit code of mmhmem setup (0 means success).
# If it could not install, it also reports a short error after its message.

function Install-Mmhmem {
    $ErrorActionPreference = 'Stop'
    $ProgressPreference = 'SilentlyContinue'
    $tag = '@@TAG@@'
    $baseUrl = '@@BASE_URL@@'
    $wantHash = '@@SHA256_WINDOWS@@'
    $target = 'x86_64-pc-windows-msvc'
    $temp = $null
    $script:MmhmemFailed = $false

    function Stop-Install([string]$Message) {
        Write-Host ''
        Write-Host $Message
        Write-Host 'Nothing was installed or changed on this computer.'
        $global:LASTEXITCODE = 1
        $script:MmhmemFailed = $true
    }

    try {
        $arch = if ($env:PROCESSOR_ARCHITEW6432) { $env:PROCESSOR_ARCHITEW6432 } else { $env:PROCESSOR_ARCHITECTURE }
        if ([Environment]::OSVersion.Platform -ne 'Win32NT' -or $arch -ne 'AMD64') {
            Stop-Install "mmhmem does not have a download for this computer ($([Environment]::OSVersion.Platform), $arch).`nIt is available for 64-bit Windows (x64), Linux (x86_64) and macOS."
            return
        }
        # Windows PowerShell 5.1 may default to protocols GitHub no longer accepts.
        try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12 } catch { }

        $archive = "mmhmem-$tag-$target.zip"
        $url = "$baseUrl/$archive"
        $temp = Join-Path ([IO.Path]::GetTempPath()) ('mmhmem-install-' + [guid]::NewGuid().ToString('N'))
        New-Item -ItemType Directory -Path $temp | Out-Null
        $file = Join-Path $temp $archive

        Write-Host "Installing mmhmem $tag for Windows (x64)."
        Write-Host "Downloading $url"
        try {
            Invoke-WebRequest -UseBasicParsing -Uri $url -OutFile $file
        } catch {
            Stop-Install "The download failed: $url`nCheck your internet connection. If it keeps failing, this release may not be published yet.`n($($_.Exception.Message))"
            return
        }

        $gotHash = (Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash.ToLowerInvariant()
        if ($gotHash -ne $wantHash.ToLowerInvariant()) {
            Stop-Install "The downloaded file does not match the checksum built into this installer, so it was NOT used.`n  expected SHA-256: $wantHash`n  actual SHA-256:   $gotHash"
            return
        }
        Write-Host 'Checked the download: SHA-256 matches.'

        try {
            Expand-Archive -LiteralPath $file -DestinationPath $temp -Force
        } catch {
            Stop-Install "The downloaded file could not be unpacked.`n($($_.Exception.Message))"
            return
        }
        $exe = Join-Path $temp 'mmhmem.exe'
        if (-not (Test-Path -LiteralPath $exe -PathType Leaf)) {
            Stop-Install 'The downloaded file did not contain mmhmem.exe.'
            return
        }

        Write-Host 'Starting mmhmem setup...'
        & $exe setup --bootstrap $tag
        $code = $LASTEXITCODE
        if ($null -eq $code) { $code = 1 }
        $global:LASTEXITCODE = $code
    } catch {
        Stop-Install "The installer stopped unexpectedly.`n($($_.Exception.Message))"
    } finally {
        if ($temp -and (Test-Path -LiteralPath $temp)) {
            try { Remove-Item -LiteralPath $temp -Recurse -Force -ErrorAction Stop } catch { Write-Host "Could not remove the temporary folder $temp" }
        }
    }
}

Install-Mmhmem
if ($script:MmhmemFailed) { Write-Error 'mmhmem was not installed.' -ErrorAction Stop }
