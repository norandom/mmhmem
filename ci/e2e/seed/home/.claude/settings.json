{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": ["Bash(npm run lint)", "Read(~/.zshrc)"],
        "deny": ["Read(./.env)"]
    },
    "env": {"EDITOR_HINT": "vim"},
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [{"type": "command", "command": "echo user-pre-bash-hook"}]
            }
        ],
        "Stop": [{"hooks": [{"type": "command", "command": "echo user-stop-hook"}]}]
    },
    "statusLine": {"type": "command", "command": "echo seeded-status"}
}