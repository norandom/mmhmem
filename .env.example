# mmhmem environment template (Req 8.1 env-only config; parser: src/config.rs).
#
# Copy to `.env` for docker compose (this file) or to
# /etc/mmhmem/mmhmem.env for systemd (deploy/systemd/mmhmem.service).
# REQUIRED: AGENT_MEM_TOKEN, AGENT_MEM_ALLOWED_ROOTS.

# ---- compose host-side knobs (NOT read by the daemon) ----

# Published host port for the MCP endpoint (container listens on 8443).
#MMHMEM_PORT=8443

# Host dirs bind-mounted into the container (data, audit log, workspace).
# The audit dir is a bind mount so host-side logrotate can rotate the JSONL
# without restarting the container (Req 8.7).
#MMHMEM_DATA_DIR=./data
#MMHMEM_LOG_DIR=./log
#MMHMEM_WORKSPACE_ROOT=./workspace

# ---- daemon configuration (AGENT_MEM_* / SHUNT_* / WORKER_* / OTEL_*) ----

# Bearer token for the MCP endpoint (REQUIRED, never logged).
AGENT_MEM_TOKEN=change-me

# Comma-separated workspace roots; every smart_read/boilerplate_write path is
# canonicalized and confined to these (REQUIRED). In compose, keep this in
# sync with the mounted workspace path, e.g. /srv/workspace.
AGENT_MEM_ALLOWED_ROOTS=/srv/workspace

# Durable state directory (default /var/lib/agent-memory).
#AGENT_MEM_DATA_DIR=/var/lib/agent-memory

# Audit JSONL file (default /var/log/agent-memory/audit.jsonl).
#AGENT_MEM_LOG_FILE=/var/log/agent-memory/audit.jsonl

# HTTP bind (defaults 0.0.0.0:8443, MCP path /mcp). In compose keep the port
# at 8443 — it must match the container port mapping and the healthcheck.
#AGENT_MEM_HOST=0.0.0.0
#AGENT_MEM_PORT=8443
#AGENT_MEM_MCP_PATH=/mcp

# smart_read shunt threshold in lines (default 150; files at/above it are
# delegated to the worker model and cached by content hash, Req 3.9).
#SHUNT_MIN_LINES=150

# OpenAI-compatible worker model endpoint (default local Ollama). WORKER_MODEL
# is required for shunt paths; leave all three unset to run without a worker
# (session/memory tools and targeted/direct reads still work, Req 9.4).
#WORKER_API_URL=http://127.0.0.1:11434/v1/chat/completions
#WORKER_MODEL=qwen3:8b
#WORKER_API_KEY=

# Optional OTel export to a self-hosted collector (Req 11). Compiled only in
# the Docker image (cargo feature `otel`); inert when the endpoint is unset,
# so the plain release binary makes no OTLP calls (Req 11.2).
#OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/org
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic change-me
#OTEL_SERVICE_NAME=mmhmem
